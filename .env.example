# Server-only. Copy to .env for local development; never commit the real values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare Pages only: comma-separated exact SHA-256 digests of approved fixtures.
APPROVED_PUBLIC_HASHES=
# Server-only. Leave unset to keep real AI paused.
GEMINI_FREE_API_KEY=
# Set yes only after confirming the key's project is free-tier (no paid billing).
GEMINI_FREE_PROJECT_CONFIRMED=no
# Optional live AI in the loopback synthetic pilot; deterministic tests override it.
# FOLIO_LIVE_SMOKE=1
# LOCAL SYNTHETIC TESTS ONLY: uncomment to use @example.test accounts on loopback.
# FOLIO_TEST_MODE=1
